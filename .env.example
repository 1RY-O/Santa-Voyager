# Nebius AI configuration — copy to .env and fill in (never commit .env)
# Get a key from https://studio.nebius.com/
NEBIUS_API_KEY=

# OpenAI-compatible endpoint + model (override only if needed)
NEBIUS_API_ENDPOINT=https://api.studio.nebius.com/v1/chat/completions
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# APP_MODE=demo (deterministic samples) or live (requires NEBIUS_API_KEY)
APP_MODE=demo
